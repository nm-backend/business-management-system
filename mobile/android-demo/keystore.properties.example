# Скопируйте в keystore.properties (он в .gitignore) и заполните.
# Ключ создаётся один раз командой keytool (входит в JDK):
#
#   keytool -genkeypair -v -keystore skladpro-demo.keystore \
#       -alias skladpro -keyalg RSA -keysize 2048 -validity 10000
#
storeFile=skladpro-demo.keystore
storePassword=ВАШ_ПАРОЛЬ_ХРАНИЛИЩА
keyAlias=skladpro
keyPassword=ВАШ_ПАРОЛЬ_КЛЮЧА
