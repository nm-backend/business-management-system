<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Основная тема приложения (без ActionBar — контент рисует WebView). -->
    <style name="Theme.SkladPro" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryDark">@color/brand_dark</item>
        <item name="android:statusBarColor">@color/brand_dark</item>
        <item name="android:windowBackground">@color/white</item>
    </style>

    <!-- Splash: экран запуска до onCreate. windowBackground = логотип на бренде. -->
    <style name="Theme.SkladPro.Splash" parent="Theme.SkladPro">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:statusBarColor">@color/splash_bg</item>
    </style>
</resources>
