# =============================================================================
# SkladPro — Production Environment Variables
# Copy this file to .env and fill in real values:
#   cp .env.prod.example .env
# Then run: docker compose up -d
# =============================================================================

# ---------- Django ----------
# Generate a strong secret key (50+ chars):
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change_me_generate_a_64_char_key_with_python_secrets

# Comma-separated list of allowed hosts/domains
ALLOWED_HOSTS=skladpro.example.com,www.skladpro.example.com

# Django environment (production / development)
DJANGO_ENV=production

# ---------- Database (PostgreSQL) ----------
DB_NAME=skladpro
DB_USER=skladpro
DB_PASSWORD=change_me_strong_db_password
DB_HOST=db
DB_PORT=5432

# ---------- Redis ----------
REDIS_URL=redis://redis:6379/0

# ---------- Domain (for nginx + SSL) ----------
# Your domain name — must have DNS A-record pointing to this server's IP
DOMAIN_NAME=skladpro.example.com

# Email for Let's Encrypt notifications (required)
# Used to send expiry warnings before certificate revocation
DOMAIN_EMAIL=admin@skladpro.example.com

# ---------- CORS ----------
# Comma-separated list of allowed origins for CORS
CORS_ALLOWED_ORIGINS=https://skladpro.example.com

# ---------- Security (Production only) ----------
# Enable HTTPS redirect (set to False behind a TLS-terminating load balancer)
SECURE_SSL_REDIRECT=True

# HSTS max-age in seconds (1 year = 31536000)
SECURE_HSTS_SECONDS=31536000

# ---------- Media ----------
MEDIA_URL=/media/
MEDIA_ROOT=media/

# ---------- Email (optional) ----------
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=skladpro@example.com
# EMAIL_HOST_PASSWORD=change_me
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=skladpro@example.com
