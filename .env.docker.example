# Пример переопределения переменных для docker compose.
# Скопируйте в .env рядом с docker-compose.yml, если хотите изменить значения.
# Без .env стек запустится со значениями по умолчанию из docker-compose.yml.
#
# ВНИМАНИЕ (безопасность): для реального сервера используйте docker-compose.prod.yml
# и НИКОГДА не выставляйте DEBUG=True или '*' в ALLOWED_HOSTS в проде — это
# раскрывает трейсбеки и снимает host-защиту. SECRET_KEY должен быть длинным
# случайным (python -c "from django.core.management.utils import get_random_secret_key as g; print(g())").

SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ENV=development
# Локальная разработка. Для прода: DEBUG=False, DJANGO_ENV=production.
DEBUG=False
# Перечислите конкретные хосты. НЕ используйте '*'.
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=skladpro_db
DB_USER=skladpro
DB_PASSWORD=skladpro
# DB_HOST и DB_PORT внутри compose фиксированы (db:5432) — здесь не задаются.

# Пароль Redis (используется и сервисом redis, и строкой REDIS_URL для web).
# Для production обязательно замените на длинный случайный.
REDIS_PASSWORD=skladpro_redis_pass

# REDIS_URL внутри compose собирается автоматически:
# redis://:${REDIS_PASSWORD}@redis:6379/0
