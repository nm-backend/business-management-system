# ── Django ────────────────────────────────────────────────
# Секретный ключ (ОБЯЗАТЕЛЬНО). Сгенерировать:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Окружение: development (по умолчанию) или production.
DJANGO_ENV=development

# Режим отладки. В production выставить False.
DEBUG=True

# Разрешённые хосты (через запятую).
ALLOWED_HOSTS=localhost,127.0.0.1

# ── База данных (PostgreSQL) ──────────────────────────────
DB_NAME=skladpro_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# ── Медиа-файлы (загрузки пользователей) ──────────────────
MEDIA_URL=/media/
MEDIA_ROOT=media/

# ── Real-time чат (WebSocket / Django Channels) ───────────
# В разработке НИЧЕГО указывать не нужно: используется in-memory канальный слой.
# В production нужен Redis (общий слой для всех воркеров):
# REDIS_URL=redis://127.0.0.1:6379/0
