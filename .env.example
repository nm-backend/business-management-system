# ── Django ────────────────────────────────────────────────
# Секретный ключ (ОБЯЗАТЕЛЬНО). Сгенерировать:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Окружение: development (по умолчанию) или production.
DJANGO_ENV=development

# Режим отладки. В production выставить False.
DEBUG=True

# Разрешённые хосты (через запятую). НЕ используйте '*' в production —
# это снимает host-защиту Django. В проде укажите конкретный домен.
# (10.0.2.2 нужен, только если открываете dev-сервер из Android-эмулятора.)
ALLOWED_HOSTS=localhost,127.0.0.1

# ── База данных (PostgreSQL) ──────────────────────────────
DB_NAME=skladpro_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# ── Медиа-файлы (загрузки пользователей) ──────────────────
MEDIA_URL=/media/
MEDIA_ROOT=media/

# ── Real-time чат (WebSocket / Django Channels) ───────────
# В разработке НИЧЕГО указывать не нужно: используется in-memory канальный слой.
# В production нужен Redis (общий слой для всех воркеров):
# REDIS_URL=redis://127.0.0.1:6379/0

# ── Фоновые задачи (Celery: авто-бэкап БД) ────────────────
# Брокер Celery берётся из REDIS_URL (см. выше) — отдельная переменная не нужна.
# Чтобы задачи РЕАЛЬНО выполнялись, нужны процессы worker и beat.
# В Docker они уже описаны в docker-compose.yml (сервисы worker и beat).
# Вручную:
#   celery -A skladpro worker -l info
#   celery -A skladpro beat -l info --scheduler django_celery_beat.schedulers:DatabaseScheduler
#
# Параметры бэкапа (S3-бакет/ключи, Telegram-токен, расписание) задаются НЕ здесь,
# а через API/интерфейс на компанию: POST /api/v1/backup/config/ (только владелец).

# ── Push-уведомления (Web Push / PWA) ─────────────────────
# Сгенерировать пару ключей:  python manage.py generate_vapid_keys
# Без них push просто не отправляется (остальное приложение работает).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# ── Логирование ───────────────────────────────────────────
# LOG_LEVEL=INFO
