# VCS / IDE
.git
.gitignore
.idea
.vscode

# Python
venv/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# Локальные секреты и окружение (env приходит из docker-compose)
.env

# Собираемое/загружаемое (это тома, а не образ)
staticfiles/
media/
test_media/

# Базы/логи/временное
*.sqlite3
*.log
scratchpad/

# Локальные данные инструментов и дампы — в образ не попадают (см. также .gitignore)
.freebuff/
backups/
.playwright-mcp/

# Документация не нужна в образе для сборки
*.md
docs/

# Stale captured test/CI logs: не используются приложением и только
# раздувают Docker build context (~20 МБ test_*.txt). Исключаем из образа.
test_full.txt
test_run2.txt
test_output.txt
check_deploy_output.txt
